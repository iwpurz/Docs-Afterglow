{
  "manifest_version": 2,
  "name": "Docs Afterglow",
  "version": "1.1.0",
  "description": "Make Google Docs and Slides yours: dark and custom color themes, animated and scenic backgrounds, typing effects and sounds, your own music, plus a Studio for building themes.",
  "browser_specific_settings": {
    "gecko": {
      "id": "docs-afterglow@local",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*",
        "https://docs.google.com/presentation/*"
      ],
      "js": [
        "shared.js",
        "canvashook.js",
        "bgengine.js",
        "layers.js",
        "content.js",
        "audio.js",
        "fx.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "scripts": [
      "shared.js",
      "themes.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Docs Afterglow",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-theme": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Toggle Docs Afterglow on/off"
    },
    "toggle-sound": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Mute / unmute typing sounds"
    },
    "toggle-music": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Play / pause ambient music"
    }
  },
  "content_security_policy": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
}
